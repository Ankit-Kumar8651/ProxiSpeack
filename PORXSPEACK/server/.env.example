# Copy to .env and edit
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MUST be changed for any real deployment
JWT_SECRET=change-this-to-a-long-random-string

# Leave MONGODB_URI empty to store users in server/data/db.json (zero setup).
# Set it to use MongoDB, e.g. mongodb://127.0.0.1:27017/proxispeak
MONGODB_URI=

# First-run administrator account (created only if it does not exist yet)
ADMIN_USER_ID=admin
ADMIN_EMAIL=admin@proxispeak.com
ADMIN_PASSWORD=Admin@12345

# Signup form: people who type this code get an admin account. Empty = nobody can self-register as admin.
ADMIN_INVITE_CODE=
